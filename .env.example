# Copy to .env (never commit .env). Every setting is optional in development.

# development | staging | production
SMARTCART_ENVIRONMENT=development
SMARTCART_LOG_LEVEL=INFO

# Database. Leave unset to use the local SQLite file (SMARTCART_DB_PATH).
# Supabase: Project Settings -> Database -> Connection string (use the pooler URI).
# SMARTCART_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
SMARTCART_DB_PATH=smartcart.db
SMARTCART_REGION=edmonton

# Supabase Auth (Project Settings -> API)
# SMARTCART_SUPABASE_URL=https://xxxx.supabase.co
# Public anon key, served to the web app at /config.js (safe to expose).
# SMARTCART_SUPABASE_ANON_KEY=
# Only for projects still using the legacy shared JWT secret:
# SMARTCART_SUPABASE_JWT_SECRET=
# Lets "delete my account" also remove the sign-in. Server-side only; never ship to the browser.
# SMARTCART_SUPABASE_SERVICE_ROLE_KEY=

# Emails that become admins (full access, no limits) when they sign in. JSON list.
# SMARTCART_ADMIN_EMAILS=["you@example.com"]

# Admin access for flyer entry and moderation until staff accounts are flagged is_admin.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SMARTCART_ADMIN_TOKEN=

# JSON list of allowed browser origins (the PWA's URL).
SMARTCART_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Error reporting (sentry.io -> project -> Client Keys)
# SMARTCART_SENTRY_DSN=
SMARTCART_SENTRY_TRACES_SAMPLE_RATE=0.0

# Run the periodic sync in the web process (dev). In production set false and
# run `python -m smartcart.worker` as its own service.
SMARTCART_RUN_SCHEDULER=true

SMARTCART_RATE_LIMIT_ENABLED=true
SMARTCART_RATE_LIMIT_DEFAULT=120/minute
SMARTCART_RATE_LIMIT_PRICE_SUBMISSIONS=60/hour
