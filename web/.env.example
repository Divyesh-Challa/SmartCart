# Leave VITE_API_URL empty in development (the Vite dev server proxies /api to :8000).
# In production, set it to the API's public URL, e.g. https://api.smartcart.example
VITE_API_URL=
# Supabase project (Project Settings -> API). The anon key is safe to ship to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
